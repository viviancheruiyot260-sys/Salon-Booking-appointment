# Copy this file to .env and replace the placeholders.
# Never commit the real .env file.

# development (default) or production.
# production forces DEBUG off and requires a real secret and ALLOWED_HOSTS.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank to use SQLite. Example for PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/glow_grace

# Customers who give an email get their booking details by email, and the
# owner gets a copy at OWNER_EMAIL. Local development prints mail in the
# terminal instead of sending it. For real inboxes, switch to SMTP.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com,
# EMAIL_HOST_PASSWORD=a 16-character Google App Password (not your normal password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Must be an address your mail server is allowed to send from.
DEFAULT_FROM_EMAIL=Glow & Grace <bookings@example.com>
# Receives a copy of every booking. Customer replies go here too.
OWNER_EMAIL=

# Shown on the public site only when set. This can differ from OWNER_EMAIL.
PUBLIC_CONTACT_EMAIL=

# Fictional placeholder. Replace with the studio WhatsApp number, digits only.
# Examples: 254712345678 or 0712345678
OWNER_WHATSAPP_NUMBER=254700000000

# Optional. Shown only when it is an http or https URL.
SOCIAL_INSTAGRAM_URL=

# Used when DJANGO_ENV=production. Set false only if TLS is ended at a proxy
# that does not send X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_CSRF_TRUSTED_ORIGINS=
